[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = Alexey Donov
	email = alexeydonov@mac.com
[alias]
  co = checkout
  st = status
  di = diff
  cm = commit
[color]
  status = auto
  diff = auto
[core]
	excludesfile = ~/.gitignore_global
  editor = nvim
[diif]
  tool = nvimdiff
[difftool "nvimdiff"]
  cmd = nvim -d $BASE $LOCAL
[init]
  defaultBranch = main
[merge]
  tool = nvimdiff
[mergetool]
  cmd = nvim -d $BASE $LOCAL
[pull]
  rebase = true
[push]
	default = current
