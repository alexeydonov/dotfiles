[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = Alexey Donov
	email = alexeydonov@mac.com
	signingkey = ~/.ssh/id_ed25519.pub
[alias]
  co = checkout
  st = status
  di = diff
  cm = commit
[color]
  status = auto
  diff = auto
[core]
	excludesfile = ~/.gitignore_global
  editor = nvim
[diif]
  tool = nvimdiff
[difftool "nvimdiff"]
  cmd = nvim -d $BASE $LOCAL
[init]
  defaultBranch = main
[merge]
  tool = nvimdiff
[mergetool]
  cmd = nvim -d $BASE $LOCAL
[pull]
  rebase = true
[push]
	default = current
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = /Users/alexey/.config/git/allowed_signers
[safe]
	directory = /private/etc/nix-darwin
